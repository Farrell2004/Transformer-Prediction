    verbose=1
)

checkpoint = ModelCheckpoint(
    filepath="models/best_transformer.keras",
    monitor="val_loss",
    save_best_only=True,
    verbose=1
)

callbacks = [
    early_stop,
    reduce_lr,
    checkpoint
]

# ----------------------------------------------------------
# Training
# ----------------------------------------------------------
EPOCHS = 100
BATCH_SIZE = 64

history = model.fit(

    X_train,
    y_train,

    validation_data=(X_valid, y_valid),

    epochs=EPOCHS,

    batch_size=BATCH_SIZE,

    callbacks=callbacks,

