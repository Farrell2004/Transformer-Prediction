# Create Sequence
# ==========================================================

def create_sequences(data, window_size, target_index):

    X = []
    y = []

    for i in range(len(data) - window_size):

        X.append(
            data[i:i+window_size]
        )

        y.append(
            data[i+window_size, target_index]
        )

    return np.array(X), np.array(y)

